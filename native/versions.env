# Pinned native sources for jAirspy releases. Sourced by the build scripts and
# read by the GitHub workflows. To move to a new upstream release, change these
# values and open a pull request.
AIRSPY_REPOSITORY=https://github.com/airspy/airspyone_host.git
# Upstream has not tagged 1.0.12, so the pin is a commit on master. It may also
# be a tag. The build checks that AIRSPY_VERSION matches the pinned airspy.h.
AIRSPY_REF=fc61ab6be57ed61f0e2bdd9c6dfae74cacef57d0
AIRSPY_VERSION=1.0.12
# Branch that the nightly build tracks.
AIRSPY_NIGHTLY_REF=master
LIBUSB_VERSION=1.0.30
LIBUSB_TARBALL_SHA256=fea36f34f9156400209595e300840767ab1a385ede1dc7ee893015aea9c6dbaf
LIBUSB_WINDOWS_7Z_SHA256=7fb1dfec805b97983763d7d0ae244320da12add1003d4249c96cc4d586398c79
# Windows only: libairspy needs POSIX threads, linked statically into airspy.dll.
PTHREADS4W_REPOSITORY=https://github.com/jwinarske/pthreads4w.git
PTHREADS4W_REF=Version-3-0-0-release
PTHREADS4W_COMMIT=07053a521b0a9deb6db2a649cde1f828f2eb1f4f
